{
  "name": "shanrail",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @shanrail/api test",
    "db:migrate": "pnpm --filter @shanrail/api db:migrate",
    "db:seed": "pnpm --filter @shanrail/api db:seed"
  }
}
