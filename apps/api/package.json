{
  "name": "@shanrail/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch dist/main.js",
    "build": "tsc",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/health-smoke.mjs",
    "db:migrate": "node --env-file-if-exists=../../.env scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=../../.env scripts/seed.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "@types/pg": "8.23.1"
  }
}
